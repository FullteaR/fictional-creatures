FROM python:3.11-slim

RUN pip install -q huggingface_hub hf_transfer

ENV HF_HUB_ENABLE_HF_TRANSFER=1

CMD ["python", "-c", "\
from huggingface_hub import hf_hub_download; \
hf_hub_download('unsloth/Qwen2.5-VL-7B-Instruct-GGUF', \
    'Qwen2.5-VL-7B-Instruct-Q4_K_M.gguf', local_dir='/models'); \
hf_hub_download('unsloth/Qwen2.5-VL-7B-Instruct-GGUF', \
    'mmproj-F16.gguf', local_dir='/models'); \
"]
