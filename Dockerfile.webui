FROM python:3.12-slim

# app (Jupyter) と同じく、推論はすべて llama-server / comfyui に HTTP で投げる。
# ここも GPU も PyTorch も要らない。src/ の生成モジュールをそのまま読んで使う。
RUN pip install --no-cache-dir \
	fastapi \
	"uvicorn[standard]" \
	Pillow \
	janome \
	python-Levenshtein \
	openai

# コードは compose 側で /web と /mnt にマウントする。src と同じく、
# 直したらコンテナを再起動するだけで反映される
ENV PYTHONUNBUFFERED=1 \
	PIPELINE_DIR=/mnt

WORKDIR /mnt
CMD ["uvicorn", "server:app", "--app-dir", "/web", "--host", "0.0.0.0", "--port", "8000"]
